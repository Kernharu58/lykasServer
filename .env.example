# ── Database ──────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=lykas

# ── JWT ───────────────────────────────────────────────
JWT_SECRET=any_long_random_string_min_32_chars
# JWT_EXPIRES_IN is superseded by the two vars below — access tokens are now
# short-lived, backed by a separate rotatable/revocable refresh token (§11.6.2).
# Kept here commented out only as a reminder of the old name; unused by the code.
# JWT_EXPIRES_IN=7d
ACCESS_TOKEN_EXPIRES_IN=20m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# ── Cloudinary (pet photos, documents) ────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Google OAuth ──────────────────────────────────────
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
ANDROID_CLIENT_ID=xxxx.apps.googleusercontent.com
IOS_CLIENT_ID=xxxx.apps.googleusercontent.com

# ── Email (for verification & password reset) ─────────
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# ─ OR use SMTP (e.g. Mailtrap for testing) ───────────
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=your_mailtrap_username
EMAIL_PASSWORD=your_mailtrap_password

# ── PayMongo (payments) ────────────────────────────────
PAYMONGO_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# ── Redis (rate-limit storage + response caching) ─────
# Optional in development: if unset, rate limiting falls back to in-memory
# storage and caching is disabled — the app still runs correctly, it just
# won't share rate-limit state across restarts/instances. Required in
# production (§11.6). Example local value: redis://localhost:6379
REDIS_URL=

# ── URLs ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000        # admin panel URL
MOBILE_APP_URL=lykas://carepaws          # deep link for the mobile app
BACKEND_URL=http://localhost:5000/api    # your own server's URL

# ── Server ────────────────────────────────────────────
PORT=5000
NODE_ENV=development
MAX_FILE_SIZE=10485760